 application "Campus Lost Item Registry"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form campus_locations
		{
			displayname = "Campus Locations"
			success message = "Campus Locations Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			location_name
			(
    			type = text
				displayname = "Location Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			building
			(
    			type = text
				displayname = "Building"
	 			row = 1
	 			column = 1   
				width = medium
			)
			block
			(
    			type = text
				displayname = "Block"
	 			row = 1
	 			column = 1   
				width = medium
			)
			floor
			(
    			type = text
				displayname = "Floor"
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_active
			(
    			type = checkbox
				displayname = "Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_by
			(
    			type = text
				displayname = "Created By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = datetime
				displayname = "Created Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			record_status1
			(
				type = radiobuttons
				displayname = "Record Status"
				values = {"Active","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form claim_request
		{
			displayname = "Claim Request"
