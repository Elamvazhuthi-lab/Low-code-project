				width = medium
			)
			added_date
			(
    			type = datetime
				displayname = "Added Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form notification_log
		{
			displayname = "Notification Log"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			recipient_name
			(
    			type = name
				displayname = "Recipient Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			recipient_email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			related_record_type
			(
				type = picklist
				displayname = "Related Record Type"
				values = {"Found Report","Return","Lost Report","Claim"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			related_record_id
			(
    			type = text
				displayname = "Related Record ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			subject_1
			(
    			type = text
				displayname = "Subject"
	 			row = 1
	 			column = 1   
				width = medium
			)
			message
			(
    			type = textarea
				displayname = "Message"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			sent_on
			(
    			type = datetime
				displayname = "Sent On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			delivery_status
			(
				type = radiobuttons
				displayname = "Delivery Status"
				values = {"Failed","Sent"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_by
			(
    			type = text
				displayname = "Created By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = datetime
				displayname = "Created Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list lost_item_report_Report
		{
			displayName = "All Item Reports"
			show all rows from lost_item_report    
			(
				reporter_name  as "Reporter Name"
				reporter_id as "Student Staff ID"
				reporter_email as "Email"
				reporter_phone as "Phone Number"
				item_name as "Item Name"
				item_category as "Category"
				item_description as "Description"
				item_color as "Color"
				item_brand as "Brand"
				date_lost as "Date Lost"
				last_seen_location as "Last Seen Location"
				item_image as "Item Image"
				status as "Status"
				added_user1 as "Added User"
				added_date as "Added Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Closed")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "Matched")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (status == "Returned")
				fields = [status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
