	share_settings
	{
			"Lost and Found Administrator"
			{
				name = "Lost and Found Administrator"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Oversee the entire lifecycle of lost and found records and manage system configurations \n"
				ModulePermissions
				{
					item_categories
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							item_categories_Report={"View","Edit","Delete"}
						}
					}
					campus_locations
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							campus_locations_Report={"View","Edit","Delete"}
						}
					}
					item_return_record
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							item_return_record_Report={"View","Edit","Delete"}
						}
					}
					notification_log
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							notification_log_Report={"View","Edit","Delete"}
							notification_log_by_related_record_type={"View","Edit","Delete"}
						}
					}
					claim_request
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							claim_request_Report={"View","Edit","Delete"}
							claim_request_by_status={"View","Edit","Delete"}
						}
					}
					found_item_report
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							found_item_report_Report={"View","Edit","Delete"}
							found_item_report_by_status={"View","Edit","Delete"}
						}
					}
					lost_item_report
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							lost_item_report_by_status={"View","Edit","Delete"}
							lost_item_report_Report={"View","Edit","Delete"}
						}
					}
				}
			}
			"Read"
			{
				name = "Read"
