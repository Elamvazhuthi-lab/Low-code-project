istribution by Claim'\n\t\n\t\ttitleSize = '15px'\n\ttype = 'Bar'\n\txtitle = 'Claim'\n\tytitle = 'Count of Claim'\n\tbgColor = '#FFFFFF'\n\ttheme = '#198391'\n\tlegendPos = 'none'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'item_return_record'\n\txfield = 'claim.claimant_name.first_name'\n\tyfields = 'count:claim'\n\tgroupBy = 'claim'\n\t\tDelugeCriteria = 'claim.claimant_name.first_name is not null'\n/>\n\n</column>\n</row>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'lost_item_report_Report'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_EditRec = 'false'\n\t\t\t\t\tzc_Print = 'false'\n\t\t\t\t\tzc_Export = 'false'\n\t\t\t\t\tzc_DelRec = 'false'\n\t\t\t\t\tzc_DuplRec = 'false'\n\t\t\t\t\tzc_Search = 'false'\n\t\t\t\t\tzc_EditBulkRec = 'false'\n\t\t\t\t\tzc_BulkDelete = 'false'\n\t\t\t\t\tzc_BulkDuplicate = 'false'\n\theightType = 'custom'\n\theightValue = '500'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			auto_set_lost_item_status as "Auto-set Lost Item Status"
			{
				type =  form
				form = lost_item_report

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set status to Open when a new lost item report is created
										if(input.ID.isNull())
										{
											input.status = "Open";
										}
						)
					}
				}

			}
			validate_claim_proof_ownership as "Validate Claim Proof of Ownership"
			{
				type =  form
				form = claim_request

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if proof_of_ownership field is empty
										if(input.proof_of_ownership.isEmpty())
										{
											// Display error message to user
											alert "Proof of ownership is required. Please upload a proof document before submitting the claim.";
											// Cancel the form submission
											cancel submit;
										}
						)
					}
				}

			}
			notify_reporter_on_match as "Notify Reporter on Match"
			{
				type =  form
				form = lost_item_report

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the current lost item report record
										lostReport = lost_item_report[ID == input.ID];
										// Check if the status has changed to Matched
										if(lostReport.status == "Matched")
										{
											// Get the reporter's email address
											reporterEmail = lostReport.reporter_email;
											// Get the item name for the email subject
											itemName = lostReport.item_name;
											// Send email notification to the reporter
											sendmail
											[
												from :zoho.loginuserid
												to :reporterEmail
												subject :"Your Lost Item Has Been Matched - " + itemName
												message :"<p>Dear Reporter,</p><p>We are pleased to inform you that your lost item '<b>" + itemName + "</b>' has been matched with a found item in our registry.</p><p>Please contact the campus security office to claim your item.</p><p>Best regards,<br>Campus Lost Item Registry Team</p>"
											]
										}
						)
					}
				}

			}
			set_default_status_new_found_item as "Set Default Status for New Found Items"
			{
				type =  form
				form = found_item_report

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set the status field to 'Unclaimed' when the form loads
										input.status = "Unclaimed";
						)
					}
				}

			}
			duplicate_location_validation as "Duplicate Location Validation"
			{
				type =  form
				form = campus_locations

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check for duplicate location_name and building combination
										if(input.location_name.isNull() || input.building.isNull())
										{
											// Allow submission if either field is empty (no duplicate check needed)
										}
										else
										{
											// Fetch existing records with same location_name and building
											duplicateRecords = campus_locations[location_name == input.location_name && building == input.building];
											// Check if any duplicate exists (excluding current record if editing)
											if(duplicateRecords.count() > 0)
											{
												alert "A location with this name and building already exists. Please enter a unique combination.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			set_default_values_on_new_location as "Set Default Values on New Location"
			{
				type =  form
				form = campus_locations

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set created_by to the logged-in user
										input.created_by = zoho.loginuser;
										// Set created_date to the current date-time
										input.created_date = zoho.currenttime;
										// Set is_active to true
										input.is_active = true;
										// Set record_status1 to "Active"
										input.record_status1 = "Active";
						)
					}
				}

			}
			Set_Processed_Details_On_Success as "Set Processed Details on Success"
			{
				type =  form
				form = item_return_record

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Set the processed_by field to the current logged-in user's email
										input.processed_by = zoho.loginuserid;
										// Set the processed_date field to the current date and time
										input.processed_date = zoho.currenttime;
						)
					}
				}

			}
			Update_Statuses_on_Return as "Update Statuses on Return"
			{
				type =  form
				form = item_return_record

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the found_item_report record linked to the current return record
										foundItemRecord = found_item_report[ID == input.found_item.ID];
										// Update the found item status to "Returned"
										if(foundItemRecord != null)
										{
											foundItemRecord.status="Returned";
										}
										// Fetch the claim_request record linked to the current return record
										claimRecord = claim_request[ID == input.claim.ID];
										// Check if the claim record exists and has a matched lost report
										if(claimRecord != null && claimRecord.matched_lost_report != null)
										{
											// Fetch the lost_item_report record linked via matched_lost_report
											lostItemRecord = lost_item_report[ID == claimRecord.matched_lost_report.ID];
											// Update the lost item status to "Returned" if found
											if(lostItemRecord != null)
											{
												lostItemRecord.status="Returned";
											}
										}
						)
					}
				}

			}
			Send_Return_Notification_Email as "Send Return Notification Email"
			{
				type =  form
				form = item_return_record

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the claimant's email from the linked claim request record
										claimRequestID = input.claim;
										if(claimRequestID != null)
										{
											claimRecord = claim_request[ID == claimRequestID];
											claimantEmail = claimRecord.claimant_email;
											if(claimantEmail != null && claimantEmail != "")
											{
												sendmail
												[
													from :zoho.adminuserid
													to :claimantEmail
													subject :"Your Item Has Been Returned"
													message :"Your item has been handed over. Thank you."
												]
											}
										}
						)
					}
				}

			}
			Log_Return_Notification as "Log Return Notification"
			{
				type =  form
				form = item_return_record

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the related claim request record using the lookup field
										claimRecord = claim_request[ID == input.claim.ID];
										// Get recipient details from the claim record
										recipientName = claimRecord.claimant_name;
										recipientEmail = claimRecord.claimant_email;
										// Prepare notification details
										notificationSubject = "Your Item Has Been Returned";
										notificationMessage = "The item you claimed has been successfully returned. Please check your item return record for details.";
										// Insert notification log record
										notificationLog = insert into notification_log
										[
											recipient_name=recipientName
											recipient_email=recipientEmail
											subject_1=notificationSubject
											message=notificationMessage
											related_record_type="Return"
											related_record_id=input.ID
											delivery_status="Sent"
											sent_on=zoho.currenttime
											created_date=zoho.currentdate
											created_by=zoho.loginuser
											Added_User=zoho.loginuser
										];
										// Log the notification creation
										info "Notification created for claim: " + claimRecord.ID;
						)
					}
				}

			}
			Set_Default_Notification_Values_On_Load as "Set Default Notification Values on Load"
			{
				type =  form
				form = notification_log

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set default values for new notification log records
										input.sent_on = zoho.currenttime;
										input.created_date = zoho.currentdate;
										input.created_by = zoho.loginuserid;
										input.delivery_status = "Sent";
						)
					}
				}

			}
			validate_unique_category_name as "Validate Unique Category Name"
			{
				type =  form
				form = item_categories

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if category_name already exists
										existingRecords = item_categories[category_name == input.category_name];
										if(existingRecords.count() > 0)
										{
											alert "This category already exists.";
											cancel submit;
										}
						)
					}
				}

			}
			set_default_values_on_load as "Set Default Values on Load"
			{
				type =  form
				form = item_categories

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set default values when the item_categories form is loaded
										input.created_by = zoho.loginuser;
										input.created_date = zoho.currentdate;
										input.is_active = true;
										input.record_status1 = "Active";
						)
					}
				}

			}
		}

		schedule
		{
			weekly_unclaimed_items_reminder as "Weekly Unclaimed Items Reminder"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch unclaimed found items from the current application
										unclaimedItems = found_item_report[status == "Unclaimed"];
										// Check if there are any unclaimed items
										if(unclaimedItems.count() > 0)
										{
											// Build the email message with item details
											messageBody = "<h2>Weekly Unclaimed Found Items Report</h2>";
											messageBody = messageBody.concat("<p>The following found items are still unclaimed:</p>");
											messageBody = messageBody.concat("<ul>");
											for each  item in unclaimedItems
											{
												itemName = item.item_name;
												itemDescription = item.item_description;
												dateFound = toString(item.added_date,"MMM dd, yyyy");
												foundLocation = item.found_location.location_name;
												messageBody = messageBody.concat("<li>");
												messageBody = messageBody.concat("<strong>Item:</strong> ");
												messageBody = messageBody.concat(itemName);
												messageBody = messageBody.concat(" - ");
												messageBody = messageBody.concat("<strong>Found on:</strong> ");
												messageBody = messageBody.concat(dateFound);
												messageBody = messageBody.concat(" - ");
												messageBody = messageBody.concat("<strong>Location:</strong> ");
												messageBody = messageBody.concat(foundLocation);
												messageBody = messageBody.concat(" - ");
												messageBody = messageBody.concat("<strong>Description:</strong> ");
												messageBody = messageBody.concat(itemDescription);
												messageBody = messageBody.concat("</li>");
											}
											messageBody = messageBody.concat("</ul>");
											messageBody = messageBody.concat("<p>Please follow up with the claim process for these items.</p>");
											// Send the email notification to security
											sendmail
											[
												from :zoho.loginuserid
												to :"security@campus.edu"
												subject :"Weekly Unclaimed Found Items Notification"
												message :messageBody
												content type :HTML
											]
										}
					)
					}
				}
			}
		}


